# OpnForm 运行环境变量（systemd EnvironmentFile）
# 端口
OPNFORM_HTTP_PORT=18080
# 内部服务端口（全部绑定 127.0.0.1）
OPNFORM_PHP_FPM_PORT=9001
OPNFORM_NODE_PORT=3000
OPNFORM_PG_PORT=5433
OPNFORM_REDIS_PORT=6380
# PHP
PHP_MEMORY_LIMIT=1G
PHP_MAX_EXECUTION_TIME=600
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=68M
# 数据库口令：首启由 opnform-setup.sh 自动生成并持久化到 data/.env-runtime
