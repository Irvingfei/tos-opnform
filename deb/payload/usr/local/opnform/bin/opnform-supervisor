#!/usr/bin/env python3
"""OpnForm TOS Deb 版进程监督器。

systemd 单元（opnform.service）以本脚本为唯一入口，由它按依赖顺序拉起
捆绑的全部运行时（PostgreSQL → Redis → PHP-FPM → Nuxt client → nginx），
并在退出时逆序停止。任何一个子进程异常退出则整体退出，重启策略由平台管理。

目录约定（均在 /usr/local/opnform 下，systemd 已声明可写）：
  depends/   捆绑运行时（php/node/postgres/redis/nginx，构建时填充）
  api/       Laravel 应用（构建时填充）
  client/    Nuxt 构建产物（构建时填充）
  data/      全部可写状态（postgres/redis/storage/run/secrets）
  logs/      日志
"""
import os
import signal
import subprocess
import sys
import time

ROOT = "/usr/local/opnform"
DEP = os.path.join(ROOT, "depends")
DATA = os.path.join(ROOT, "data")
LOGS = os.path.join(ROOT, "logs")

HTTP_PORT = os.environ.get("OPNFORM_HTTP_PORT", "18080")
PHP_PORT = os.environ.get("OPNFORM_PHP_FPM_PORT", "9001")
NODE_PORT = os.environ.get("OPNFORM_NODE_PORT", "3000")
PG_PORT = os.environ.get("OPNFORM_PG_PORT", "5433")
REDIS_PORT = os.environ.get("OPNFORM_REDIS_PORT", "6380")

for d in ("postgres", "redis", "run", "storage/logs", "storage/framework/sessions",
          "storage/framework/views", "storage/framework/cache/data", "storage/app/public"):
    os.makedirs(os.path.join(DATA, d), exist_ok=True)
os.makedirs(LOGS, exist_ok=True)

PHP = os.path.join(DEP, "php", "bin", "php")
PHP_FPM = os.path.join(DEP, "php", "sbin", "php-fpm")
NODE = os.path.join(DEP, "node", "bin", "node")
PG_BIN = os.path.join(DEP, "postgres", "bin")
REDIS_SRV = os.path.join(DEP, "redis", "bin", "redis-server")
REDIS_CLI = os.path.join(DEP, "redis", "bin", "redis-cli")
NGINX = os.path.join(DEP, "nginx", "sbin", "nginx")

procs: list[tuple[str, subprocess.Popen]] = []


def log(msg: str) -> None:
    print(f"[opnform-supervisor] {msg}", flush=True)


def start(name: str, cmd: list[str], **kw) -> subprocess.Popen:
    logout = open(os.path.join(LOGS, f"{name}.log"), "ab")
    p = subprocess.Popen(cmd, stdout=logout, stderr=logout, **kw)
    procs.append((name, p))
    log(f"started {name} (pid {p.pid})")
    return p


def wait_http(port: str, timeout: int = 60) -> bool:
    import urllib.request
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=2)
            return True
        except Exception:
            # HTTP 错误码（404/500）也算端口已就绪
            time.sleep(1)
    return False


def wait_pg(timeout: int = 120) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        r = subprocess.run([os.path.join(PG_BIN, "pg_isready"), "-h", "127.0.0.1",
                            "-p", PG_PORT, "-U", "opnform"],
                           capture_output=True)
        if r.returncode == 0:
            return True
        time.sleep(1)
    return False


def wait_redis(timeout: int = 30) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        r = subprocess.run([REDIS_CLI, "-p", REDIS_PORT, "ping"], capture_output=True)
        if b"PONG" in r.stdout:
            return True
        time.sleep(1)
    return False


def wait_port(port: str, timeout: int = 60) -> bool:
    import socket
    deadline = time.time() + timeout
    while time.time() < deadline:
        s = socket.socket()
        s.settimeout(1)
        try:
            s.connect(("127.0.0.1", int(port)))
            s.close()
            return True
        except OSError:
            s.close()
            time.sleep(1)
    return False


def main() -> int:
    # 0) 首启初始化（密钥生成 / 数据库 initdb+迁移 / Passport keys）
    setup = subprocess.run(["bash", os.path.join(ROOT, "bin", "opnform-setup.sh")])
    if setup.returncode != 0:
        log("FATAL: opnform-setup.sh failed, see logs/setup.log")
        return 1

    # 1) PostgreSQL（捆绑实例，数据在 data/postgres）
    pg_data = os.path.join(DATA, "postgres")
    start("postgres", [
        os.path.join(PG_BIN, "postgres"),
        "-D", pg_data, "-p", PG_PORT,
        "-c", "listen_addresses=127.0.0.1",
        "-c", "unix_socket_directories=" + os.path.join(DATA, "run"),
    ])
    if not wait_pg():
        log("FATAL: postgres not ready in time")
        return 1

    # 1.5) 数据库迁移/初始化（postgres 就绪后执行一次）
    mig = subprocess.run(["bash", os.path.join(ROOT, "bin", "opnform-migrate.sh")])
    if mig.returncode != 0:
        log("FATAL: opnform-migrate.sh failed, see logs/setup.log")
        return 1

    # 2) Redis
    start("redis", [REDIS_SRV, "--port", REDIS_PORT, "--bind", "127.0.0.1",
                    "--dir", os.path.join(DATA, "redis"),
                    "--save", "60 1", "--appendonly", "no"])
    if not wait_redis():
        log("FATAL: redis not ready in time")
        return 1

    # 3) PHP-FPM（端口模式，进程属主即当前用户 opnform）
    start("php-fpm", [PHP_FPM, "--nodaemonize", "--fpm-config",
                      os.path.join(DEP, "php", "etc", "php-fpm.conf")])
    if not wait_port(PHP_PORT, 60):
        log("FATAL: php-fpm not ready in time")
        return 1

    # 4) Nuxt client
    start("node", [NODE, os.path.join(ROOT, "client", "server", "index.mjs")],
          cwd=os.path.join(ROOT, "client"))
    if not wait_port(NODE_PORT, 120):
        log("FATAL: node client not ready in time")
        return 1

    # 5) nginx（应用实例，prefix 指向自身运行时目录，conf 覆盖监听端口）
    start("nginx", [NGINX, "-p", os.path.join(DEP, "nginx"), "-c",
                    os.path.join(ROOT, "nginx", "nginx.conf"),
                    "-g", f"pid {DATA}/run/nginx.pid;"])
    if not wait_http(HTTP_PORT, 60):
        log("FATAL: nginx not ready in time")
        return 1

    log(f"all services up; web UI on http://<nas-ip>:{HTTP_PORT}")

    # 监听退出信号与子进程死亡
    stop_requested = {"flag": False}

    def on_signal(signum, _frame):
        log(f"signal {signum} received, shutting down")
        stop_requested["flag"] = True

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    while not stop_requested["flag"]:
        for name, p in procs:
            if p.poll() is not None:
                log(f"FATAL: child {name} exited with code {p.returncode}")
                shutdown()
                return 1
        time.sleep(2)

    shutdown()
    return 0


def shutdown() -> None:
    # 逆序优雅停止
    for name, p in reversed(procs):
        if p.poll() is None:
            p.terminate()
    deadline = time.time() + 30
    for name, p in procs:
        try:
            p.wait(timeout=max(1, deadline - time.time()))
        except subprocess.TimeoutExpired:
            log(f"killing {name}")
            p.kill()
    # pg_ctl 优雅停库
    subprocess.run([os.path.join(PG_BIN, "pg_ctl"), "-D", os.path.join(DATA, "postgres"),
                    "-m", "fast", "stop"], capture_output=True)
    log("all services stopped")


if __name__ == "__main__":
    sys.exit(main())
