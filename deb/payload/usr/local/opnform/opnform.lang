# OpnForm — TOS 7 应用多语言文件（26 语言，语种与顺序按指南 §8.5.1）
# 未翻译语种按规范以英文填充；name/auth/descript 每节均非空。
# __PUBLISHER__ 由 make-packages.sh 注入。

[zh-cn]
name = "OpnForm"
auth = "__PUBLISHER__"
descript = "开源表单构建器，在 NAS 上完全私有化部署：拖拽创建表单、收集回答、分析结果，数据不出家庭网络。"
release_note = "1. 首个 TOS 7 版本，同时提供 x86_64 与 aarch64 架构包。"
important = "首次启动需初始化数据库，约 1-2 分钟，请耐心等待。所有数据保存在 NAS 本地。"

[zh-hk]
name = "OpnForm"
auth = "__PUBLISHER__"
descript = "開源表單構建器，在 NAS 上完全私有化部署：拖拽建立表單、收集回答、分析結果，資料不出家庭網路。"
release_note = "1. 首個 TOS 7 版本，同時提供 x86_64 與 aarch64 架構包。"
important = "首次啟動需初始化資料庫，約 1-2 分鐘，請耐心等待。所有資料保存在 NAS 本地。"

[en-us]
name = "OpnForm"
auth = "__PUBLISHER__"
descript = "Open-source form builder, fully self-hosted on your NAS: create forms by drag and drop, collect responses and analyze results — your data never leaves your network."
release_note = "1. Initial release for TOS 7, available for both x86_64 and aarch64."
important = "First launch initializes the database (~1-2 minutes). All data stays on your NAS."

[ko-kr]
name = "OpnForm"
auth = "__PUBLISHER__"
descript = "오픈소스 폼 빌더. NAS에 완전히 자체 호스팅되어 드래그 앤 드롭으로 폼을 만들고 응답을 수집·분석할 수 있습니다. 데이터는 네트워크를 떠나지 않습니다."
release_note = "1. TOS 7 최초 릴리스, x86_64 및 aarch64 아키텍처 지원."
important = "첫 실행 시 데이터베이스를 초기화합니다(약 1-2분). 모든 데이터는 NAS에 저장됩니다."

